      "id": "ffb17ded-c35a-48bb-9b0e-6adda46bf134",
      "text": "Discuss the principles of object-oriented programming in Java. How do these principles influence your design decisions when developing applications?",
      "question_type": "SITUATIONAL",
      "difficulty": "HARD",
      "skills": [
        "Java"
      ],
      "tags": [],
      "evaluation_criteria": null,
