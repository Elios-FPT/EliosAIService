            evaluation = Evaluation(
                answer_id=answer.id,
                question_id=q_id,
                interview_id=sample_interview_adaptive.id,
                raw_score=80.0 + (idx * 5),
                final_score=80.0 + (idx * 5),
                completeness=0.8,
                relevance=0.9,
                sentiment="confident",
                reasoning=f"Good answer {idx + 1}",
                strengths=[f"Strength {idx + 1}"],
