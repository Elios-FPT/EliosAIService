    # Invalid percentage (< 0)
    with pytest.raises(ValueError):
        PromptTemplate(
            prompt_name="test",
            version=1,
            template_json={
                "system": "test",
                "user_template": "test",
                "variables": [],
            },
            traffic_percentage=-1,
