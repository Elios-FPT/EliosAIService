      "change_summary": null,
      "template_json": "{\"system\": \"You are an expert technical interviewer explaining evaluation criteria.\\nExplain why an answer demonstrates mastery.\", \"variables\": [\"question_text\", \"ideal_answer\"], \"constraints\": \"50-100 words. Temperature: 0.3. Max tokens: 200. Use gpt-3.5-turbo for cost savings.\", \"user_template\": \"Question: {question_text}\\nIdeal Answer: {ideal_answer}\\n\\nExplain WHY this is an ideal answer in 50-100 words. Focus on:\\n- What key concepts are covered\\n- Why this demonstrates mastery\\n- What would be missing in a weaker answer\\n\\nOutput only the rationale text.\"}",
