class CVProcessingAdapter(CVAnalyzerPort):

    def __init__(
            self,
            embedding_model:str="text-embedding-3-small",
            model:str="gpt-4o-mini",
            candidate_repository_port: CandidateRepositoryPort = None):

        self.settings  = Settings()
