"""Unit tests for LangSmith configuration and PII filtering."""

import pytest
from unittest.mock import Mock, patch
from uuid import UUID

from src.infrastructure.observability.langsmith_config import (
    PIIFilteringTracer,
    setup_langsmith_tracing,
