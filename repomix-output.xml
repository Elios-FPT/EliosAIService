        assert len(result["companies"]) >= 1
        assert len(result["locations"]) >= 1
        assert len(result["skills"]) >= 5
        assert result["experience_years"] is not None
        assert result["confidence"]["overall"] > 0.5
        assert result["language"] in {"en", "vi"}

