                "score": 85.0,
                "feedback": "Good answer",
                "strengths": ["Clear explanation"],
                "weaknesses": ["Missing examples"],
                "missing_concepts": ["Error handling"],
            }
        )

        # Patch _get_or_build_chain to return our mock chain
