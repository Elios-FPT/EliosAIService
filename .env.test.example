# =============================================================================
# TEST ENVIRONMENT CONFIGURATION
# =============================================================================
# Copy this file to .env.test and configure for your test environment
# This file is automatically loaded when running: python -m tests.bot.run_tests
#
# IMPORTANT: .env.test is gitignored - never commit test credentials
# =============================================================================

# =============================================================================
# Database Configuration (TEST DATABASE ONLY)
# =============================================================================
# CRITICAL: Use a separate test database to avoid contaminating dev/prod data
# The test runner will insert and delete data during tests
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/elios_test

# =============================================================================
# Mock Adapter Settings
# =============================================================================
# Mock tests (8 scenarios, $0 cost): USE_MOCK_ADAPTERS=true
# Real tests (5 scenarios, ~$0.45 cost): USE_MOCK_ADAPTERS=false
USE_MOCK_ADAPTERS=true

# =============================================================================
# LLM Provider Configuration (for real tests)
# =============================================================================
# Required for real tests (--scenarios real)
# Mock tests don't need API keys (USE_MOCK_ADAPTERS=true skips LLM calls)
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# Alternative: Azure OpenAI
# LLM_PROVIDER=azure_openai
# AZURE_OPENAI_API_KEY=your-azure-key
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
# AZURE_OPENAI_DEPLOYMENT=your-deployment-name

# =============================================================================
# Vector Database Configuration (for real tests)
# =============================================================================
# Required for real tests
VECTOR_DB_PROVIDER=pinecone
PINECONE_API_KEY=your-pinecone-api-key-here
PINECONE_INDEX_NAME=elios-test
PINECONE_ENVIRONMENT=us-east-1

# Alternative: ChromaDB (local, no API key needed)
# VECTOR_DB_PROVIDER=chroma
# CHROMA_PERSIST_DIRECTORY=./test_data/chroma

# =============================================================================
# Observability & Tracing (optional)
# =============================================================================
# LangSmith for cost tracking and tracing (optional but recommended for real tests)
LANGCHAIN_TRACING_V2=false
LANGSMITH_API_KEY=your-langsmith-api-key-here
LANGCHAIN_PROJECT=elios-test-bot

# =============================================================================
# Application Settings
# =============================================================================
# Environment identifier (CRITICAL: Must be "test" to load this config file)
# The main application reads this variable to determine which .env file to load
ENVIRONMENT=test

# Logging level (DEBUG for verbose test output)
LOG_LEVEL=INFO

# Application name (helps identify test runs in logs)
APP_NAME=elios-interview-test-bot

# =============================================================================
# Speech Services (optional - not used in current test scenarios)
# =============================================================================
# AZURE_SPEECH_KEY=your-azure-speech-key
# AZURE_SPEECH_REGION=eastus

# =============================================================================
# Test Runner Settings
# =============================================================================
# Base URL for API calls (default: http://localhost:8000)
# API_BASE_URL=http://localhost:8000

# WebSocket URL (default: ws://localhost:8000)
# WS_BASE_URL=ws://localhost:8000

# Test timeout (seconds)
# DEFAULT_TEST_TIMEOUT=30

# =============================================================================
# CI/CD Environment Variables (auto-detected)
# =============================================================================
# CI=true  # Set automatically in CI environments
# GITHUB_ACTIONS=true  # Set by GitHub Actions
